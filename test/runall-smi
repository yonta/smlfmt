#!/usr/bin/python3

# Formats every .smi under a SML# source tree and checks the result.
#
# This is not run by test/runall, because it needs a SML# checkout, which this
# repository does not ship. Point it at one:
#
#   test/runall-smi ~/tmp/smlsharp-4.2.0/src

import argparse, sys, os, json, subprocess, errno

def get_git_root():
  return subprocess.Popen(['git', 'rev-parse', '--show-toplevel'],
    stdout=subprocess.PIPE).communicate()[0].rstrip().decode()

def error_and_exit(msg):
  sys.stderr.write('[ERROR] ' + msg)
  sys.exit(1)

def run_must_succeed(cmd):
  process = \
    subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
  out, err = process.communicate()
  if process.returncode != 0:
    sys.stderr.write(out.decode() + "\n" + err.decode() + "\n")
    error_and_exit("command failed:\n  {}\n".format(" ".join(cmd)))

def info(msg):
  print('[INFO] ' + msg)

if len(sys.argv) != 2:
  error_and_exit('usage: {} SMLSHARP_SOURCE_DIR\n'.format(sys.argv[0]))

ROOT = get_git_root()
SRC = sys.argv[1]

info('building parser...')
run_must_succeed(['make', '-C', ROOT, 'smlfmt'])
info('built parser successfully')

MAIN = os.path.join(ROOT, 'smlfmt')

paths = []
for dirpath, dirnames, names in os.walk(SRC):
  for name in names:
    if name.endswith('.smi'):
      paths.append(os.path.join(dirpath, name))
paths.sort()

if len(paths) == 0:
  error_and_exit('no .smi files under {}\n'.format(SRC))

info('found {} .smi files'.format(len(paths)))

problems = []

for path in paths:
  cmd = [MAIN, '--preview-only', '--safety-check', path]
  process = \
    subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
  out, err = process.communicate()
  if process.returncode != 0:
    problems.append((path, out.decode() + err.decode()))

print('')
if len(problems) == 0:
  info('SUCCESS! All {} files formatted.'.format(len(paths)))
else:
  for path, output in problems:
    sys.stderr.write('\n=== {} ===\n{}'.format(path, output))
  error_and_exit('{} of {} files failed.\n'.format(len(problems), len(paths)))
